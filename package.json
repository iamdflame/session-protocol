{
  "name": "session",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "description": "Split a tokenized equity into the hours arbitrage works and the hours it does not",
  "scripts": {
    "test": "npm run check:eligibility && npm run test:rust && npm run test:ts",
    "test:rust": "cargo test -p session",
    "test:ts": "node --experimental-strip-types tests/calendar.check.ts && node --experimental-strip-types tests/layout.test.ts && node --experimental-strip-types tests/health.test.ts && node --experimental-strip-types tests/ix.test.ts && node --experimental-strip-types tests/issuer.test.ts && node --experimental-strip-types tests/events.test.ts && node --experimental-strip-types tests/event.test.ts && node --experimental-strip-types tests/statement.test.ts",
    "vectors": "node --experimental-strip-types tests/gen-vectors.ts && node --experimental-strip-types tests/gen-settle-vectors.ts && cargo test -p session --lib emit_account_vector",
    "keeper": "node --experimental-strip-types keeper/src/index.ts",
    "data": "node scripts/discover.mjs > data/_raw-universe.json && node scripts/history.mjs && node research/fetch-hourly.mjs",
    "collect": "node --experimental-strip-types keeper/src/collector.ts",
    "derive": "node --experimental-strip-types research/derive.ts && node --experimental-strip-types research/session-study.ts",
    "study": "node --experimental-strip-types research/session-study.ts",
    "exec-cost": "node research/executability.mjs",
    "devnet:init": "node --experimental-strip-types keeper/src/devnet-init.ts",
    "devnet:crank": "node --experimental-strip-types keeper/src/devnet-crank.ts",
    "devnet:check": "node --experimental-strip-types keeper/src/devnet-encoding-check.ts && node --experimental-strip-types keeper/src/devnet-trade-check.ts",
    "devnet:statement": "node --experimental-strip-types keeper/src/statement-check.ts",
    "build:program": "./scripts/build-sbf.sh",
    "test:validator": "node --experimental-strip-types keeper/src/validator-test.ts",
    "devnet:recap": "node --experimental-strip-types keeper/src/recap.ts",
    "gate:pool": "node --experimental-strip-types keeper/src/gate-token2022-pool.ts",
    "pools": "node --experimental-strip-types keeper/src/pools.ts",
    "wallet": "node --experimental-strip-types keeper/src/wallet.ts",
    "devnet:event": "node --experimental-strip-types keeper/src/devnet-event.ts",
    "devnet:detector": "node --experimental-strip-types keeper/src/devnet-detector.ts",
    "devnet:curate": "node --experimental-strip-types keeper/src/curate.ts",
    "devnet:auction": "node --experimental-strip-types keeper/src/devnet-auction.ts",
    "bell": "node --experimental-strip-types agent/launch.ts",
    "bell:verify": "node --experimental-strip-types agent/verify.ts",
    "mcp": "node --experimental-strip-types agent/mcp.ts",
    "auction": "node --experimental-strip-types keeper/src/auction.ts",
    "retune": "node --experimental-strip-types keeper/src/retune.ts",
    "check:eligibility": "node scripts/eligibility.mjs"
  },
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "^1.4.9",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pythnetwork/pyth-solana-receiver": "^0.16.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "1.98.4",
    "bn.js": "^5.2.5"
  },
  "license": "MIT",
  "overrides": {
    "jito-ts": {
      "@solana/web3.js": "$@solana/web3.js"
    },
    "@solana/web3.js": "$@solana/web3.js"
  }
}
